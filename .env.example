# Copy to .env and fill in. All scripts assume the repository root as the working directory.

# Where the downloaded datasets were unpacked, one subdirectory per source.
MEDJEV_SOURCE=/path/to/downloads
# Where prepare_data.py writes the manifests and the extracted images.
MEDJEV_DATA=/path/to/medjev-data
# Where the backbone and the trained checkpoints live.
MEDJEV_MODELS=/path/to/models
# Where training and evaluation write their runs.
MEDJEV_WORK=/path/to/work
